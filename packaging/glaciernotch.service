[Unit]
Description=GlacierNotch desktop overlay
After=graphical-session.target
StartLimitIntervalSec=30
StartLimitBurst=3

[Service]
Type=simple
ExecStart=%h/Applications/GlacierNotch
Environment=DISPLAY=:0
Environment=XAUTHORITY=%h/.Xauthority
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
